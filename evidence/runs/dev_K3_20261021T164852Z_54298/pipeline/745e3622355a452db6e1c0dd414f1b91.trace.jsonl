{"trace_schema": "local-pipeline-1", "run_id": "745e3622355a452db6e1c0dd414f1b91", "sequence": 4, "recorded_at": "2026-10-21T16:54:05.238953+00:00", "event": "stage", "data": {"stage": "s4", "latency_ms": 15548.636, "value": [{"sql": "SELECT T1.nama AS wilayah, T1.periode, SUM(T2.nilai) AS nilai\nFROM provinsi AS T1\nJOIN nilai_indikator AS T2 ON T1.kode = T2.kode_provinsi\nWHERE T2.kode_indikator = :indikator AND T2.periode = :periode AND T1.kode IN (:wilayah_0, :wilayah_1)\nGROUP BY T1.nama, T1.periode", "valid": false, "reject_reason": "bentuk SQL: tanpa fungsi agregat"}, {"sql": "SELECT \n    provinsi.nama AS wilayah,\n    nilai_indikator.periode AS periode,\n    nilai_indikator.nilai AS nilai\nFROM \n    provinsi\nJOIN \n    nilai_indikator ON provinsi.kode = nilai_indikator.kode_provinsi\nWHERE \n    nilai_indikator.kode_indikator = :indikator\n    AND nilai_indikator.periode = :periode\n    AND nilai_indikator.kode_provinsi IN (:wilayah_0, :wilayah_1)\nORDER BY \n    nilai DESC;", "valid": true, "reject_reason": null}, {"sql": "SELECT provinsi.nama AS wilayah, periode, SUM(nilai) AS nilai\nFROM nilai_indikator\nINNER JOIN provinsi ON nilai_indikator.kode_provinsi = provinsi.kode\nWHERE nilai_indikator.kode_indikator = :indikator\n  AND nilai_indikator.periode = :periode\n  AND nilai_indikator.kode_provinsi IN (:wilayah_0, :wilayah_1)\nGROUP BY provinsi.kode, periode\nORDER BY nilai DESC;", "valid": false, "reject_reason": "bentuk SQL: tanpa fungsi agregat"}, {"sql": "SELECT \n    provinsi.nama AS wilayah,\n    nilai_indikator.periode AS periode,\n    nilai_indikator.nilai AS nilai\nFROM \n    provinsi\nJOIN \n    nilai_indikator\nON \n    provinsi.kode = nilai_indikator.kode_provinsi\nWHERE \n    nilai_indikator.kode_indikator = :indikator\n    AND nilai_indikator.periode = :periode\n    AND nilai_indikator.kode_provinsi IN (:wilayah_0, :wilayah_1)", "valid": true, "reject_reason": null}, {"sql": "SELECT DISTINCT T1.nama AS wilayah, T2.nilai AS nilai\nFROM pr