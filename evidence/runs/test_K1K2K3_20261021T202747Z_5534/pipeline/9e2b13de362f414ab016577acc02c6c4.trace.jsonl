{"trace_schema": "local-pipeline-1", "run_id": "9e2b13de362f414ab016577acc02c6c4", "sequence": 4, "recorded_at": "2026-10-21T21:16:12.720554+00:00", "event": "stage", "data": {"stage": "s4", "latency_ms": 12072.575, "value": [{"sql": "SELECT provinsi.nama AS wilayah, periode, nilai_indikator.nilai\nFROM provinsi\nJOIN nilai_indikator ON provinsi.kode = nilai_indikator.kode_provinsi\nWHERE nilai_indikator.kode_indikator = :indikator\n  AND nilai_indikator.periode = :periode\n  AND nilai_indikator.kode_provinsi IN (:wilayah_0)\nORDER BY nilai ASC; -- Assuming the highest value is the most relevant APK", "valid": false, "reject_reason": "harus tepat satu pernyataan"}, {"sql": "SELECT T1.nama AS wilayah, T2.periode, T2.nilai\nFROM provinsi AS T1\nJOIN nilai_indikator AS T2\nON T1.kode = T2.kode_provinsi\nWHERE T2.kode_indikator = :indikator\n  AND T2.periode = :periode\n  AND T2.kode_provinsi IN (:wilayah_0)", "valid": true, "reject_reason": null}, {"sql": "SELECT provinsi.nama AS wilayah, periode, SUM(nilai) AS nilai\nFROM nilai_indikator\nINNER JOIN provinsi ON nilai_indikator.kode_provinsi = provinsi.kode\nWHERE nilai_indikator.kode_indikator = :indikator\nAND nilai_indikator.periode = :periode\nAND nilai_indikator.kode_provinsi IN (:wilayah_0)\nGROUP BY provinsi.nama, periode\nORDER BY nilai DESC\nLIMIT 1;", "valid": false, "reject_reason": "bentuk SQL: tanpa fungsi agregat"}, {"sql": "SELECT T1.nama AS wilayah, T2.periode, T2.nilai\nFROM provinsi AS T1\nJOIN nilai_indikator AS T2 ON T1.kode = T2.kode_provinsi\nWHERE T2.kode_indikator = :indikator\n  AND T2.periode = :periode\n  AND T1.kode IN (:wilayah_0)\nORDER BY T2.nilai DESC;", "valid": true, "reject_reason": null}, {"sql": "SELECT DISTINCT provinsi.nama AS wilayah, nilai_indikator.nilai AS nilai\nFROM nilai_indikator\nJOIN provinsi ON nilai_indikator.kode_provinsi = provinsi.kode\nWHERE nilai_indikator.kode_indikator = :indikator\n  AND nilai_indikator.periode = :periode\n  AND provinsi.kode IN (:wilayah_0)\nORDER BY nilai DESC", "valid": true, "reject_reason": null}, {"sql": "SELECT \n  provinsi.nama AS wilayah,\n  nilai_indikator.periode AS periode,\n  SUM(nilai_indikator.nilai) AS nilai\nFROM \n  nilai_indikator\nJOIN \n  provinsi ON nilai_indikator.kode_provinsi = provinsi.kode\nWHERE \n  nilai_indikator.kode_indikator = :indikator\n  AND nilai_indikator.periode = :periode\n  AND nilai_indikator.kode_provinsi IN (:wilayah_0)\nGROUP BY \n  provinsi.nama, nilai_indikator.periode\nORDER BY \n  nilai DESC\nLIMIT 1;", "valid": false, "reject_reason": "bentuk SQL: tanpa fungsi agregat"}, {"sql": "SELECT \n    provinsi.nama AS wilayah,\n    nilai_indikator.periode AS periode,\n    nilai_indikator.nilai AS nilai\nFROM \n    provinsi\nJOIN \n    nilai_indikator ON provinsi.kode = nilai_indikator.kode_provinsi\nWHERE \n    nilai_indikator.kode_indikator = :indikator\n    AND nilai_indikator.periode = :periode\n    AND nilai_indikator.kode_provinsi IN (:wilayah_0)\nORDER BY \n    nilai DESC;", "valid": true, "reject_reason": null}, {"sql": "SELECT provinsi.nama AS wilayah, nilai_indikator.nilai AS nilai FROM provinsi INNER JOIN nilai_indikator ON provinsi.kode = nilai_indikator.kode_provinsi WHERE nilai_indikator.kode_indikator = :indikator AND nilai_indikator.periode = :periode AND nilai_indikator.kode_provinsi IN (:wilayah_0)", "valid": true, "reject_reason": null}]}}
