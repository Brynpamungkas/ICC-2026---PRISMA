_indikator.kode_provinsi = provinsi.kode\nWHERE\n    nilai_indikator.kode_indikator = :indikator\nAND nilai_indikator.periode = :periode\nAND nilai_indikator.kode_provinsi IN (:wilayah_0, :wilayah_1)\nGROUP BY\n    provinsi.nama,\n    periode\nORDER BY\n    nilai DESC\nLIMIT 1", "valid": false, "reject_reason": "bentuk SQL: AVG tanpa kolom wilayah, GROUP BY, ORDER BY, dan LIMIT"}, {"sql": "SELECT T3.nama AS wilayah, AVG(T1.nilai) AS nilai\nFROM nilai_indikator AS T1\nINNER JOIN provinsi AS T2 ON T1.kode_provinsi = T2.kode\nINNER JOIN indikator AS T3 ON T1.kode_indikator = T3.kode\nWHERE T1.kode_indikator = :indikator\nAND T1.periode = :periode\nAND T1.kode_provinsi IN (:wilayah_0, :wilayah_1)\nGROUP BY T3.nama, T1.periode", "valid": false, "reject_reason": "bentuk SQL: AVG tanpa kolom wilayah, GROUP BY, ORDER BY, dan LIMIT"}, {"sql": "SELECT SUM(nilai_indikator.nilai) / COUNT(DISTINCT nilai_indikator.kode_provinsi) AS nilai FROM nilai_indikator WHERE nilai_indikator.kode_indikator = :indikator AND nilai_indikator.periode = :periode AND nilai_indikator.kode_provinsi IN (:wilayah_0, :wilayah_1)", "valid": false, "reject_reason": "bentuk SQL: harus tepat satu AVG"}, {"sql": "SELECT AVG(nilai_indikator.nilai) AS nilai\nFROM nilai_indikator\nWHERE nilai_indikator.kode_indikator = :indikator\nAND nilai_indikator.periode = :periode\nAND nilai_indikator.kode_provinsi IN (:wilayah_0, :wilayah_1);", "valid": true, "reject_reason": null}]}}
